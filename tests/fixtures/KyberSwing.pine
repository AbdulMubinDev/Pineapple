//@version=6
// ============================================================================
// KyberSwing v1.1 — Asymmetric Trend Swing System for Crypto Perpetual Futures
// Author: Abdul Mubin (Kybernode) · built with Claude
//
// Rules distilled from:
//   - Moskowitz, Ooi & Pedersen (2012) Time Series Momentum
//   - Hurst, Ooi & Pedersen (2017) A Century of Evidence on Trend-Following
//   - Zarattini, Pagani & Barbon (2025) Catching Crypto Trends (close-based Donchian
//     breakout + midpoint trailing stop + volatility sizing)
//   - Han, Kang & Ryu (2023) — crypto shorts earn far less than longs -> shorts are
//     stricter and smaller
//   - Original Turtle rules (Curtis Faith): breakout, 2N stop, % risk sizing
//   - Elder Triple Screen: higher timeframe picks direction
//   - Clenow, Following the Trend: moving-average regime filter
//
// Designed for the 4H chart. Works on TradingView and Vela (LuxAlgo) — Pine v6.
// ============================================================================
strategy("KyberSwing v1.1", shorttitle = "KyberSwing", overlay = true,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, pyramiding = 0, process_orders_on_close = false,
     calc_on_every_tick = false, margin_long = 20, margin_short = 20)

// ---------------------------------------------------------------- inputs ----
grpR = "1 · Regime (higher timeframe)"
regTf     = input.timeframe("D", "Regime timeframe", group = grpR)
emaFastL  = input.int(50,  "Fast EMA", minval = 5, group = grpR)
emaSlowL  = input.int(200, "Slow EMA", minval = 20, group = grpR)

grpE = "2 · Entry (breakout)"
brkLen    = input.int(55, "Breakout length (bars, close-based)", minval = 5, group = grpE)
useAdx    = input.bool(false, "Require ADX trend strength (tested: hurts)", group = grpE)
adxLen    = input.int(14, "ADX length", group = grpE)
adxLong   = input.float(20, "Min ADX for longs", group = grpE)
adxShort  = input.float(25, "Min ADX for shorts (stricter)", group = grpE)
allowLong  = input.bool(true, "Allow longs", group = grpE)
allowShort = input.bool(true, "Allow shorts", group = grpE)

grpX = "3 · Stops and exits"
atrLen    = input.int(20, "ATR length (Turtle N)", group = grpX)
stopMult  = input.float(2.0, "Initial stop (× ATR)", step = 0.25, group = grpX)
trailMode = input.string("Midpoint", "Trailing stop", options = ["Midpoint", "Chandelier", "Donchian"], group = grpX,
     tooltip = "Midpoint: halfway between highest and lowest close of the trail window (Zarattini/Barbon). Chandelier: highest high − k×ATR. Donchian: opposite channel of the trail window (Turtle exit).")
trailLen  = input.int(55, "Trail window (bars)", minval = 3, group = grpX)
chandMult = input.float(3.0, "Chandelier multiple (× ATR)", step = 0.25, group = grpX)
usePartial = input.bool(false, "Take 50% profit at target", group = grpX)
tpR       = input.float(2.0, "Target (R multiple)", step = 0.25, group = grpX)

grpS = "4 · Risk and sizing"
riskLong  = input.float(1.0, "Risk per long (% equity)", step = 0.1, group = grpS)
riskShort = input.float(0.5, "Risk per short (% equity)", step = 0.1, group = grpS)
maxLev    = input.float(3.0, "Max effective leverage", step = 0.5, group = grpS)

grpV = "5 · Visuals"
showBands = input.bool(true, "Show breakout channel", group = grpV)
showRegBg = input.bool(true, "Shade regime background", group = grpV)

// ---------------------------------------------------------------- regime ----
// [1] + lookahead_on = last COMPLETED higher-timeframe bar -> no repainting
[htfClose, htfFast, htfSlow] = request.security(syminfo.tickerid, regTf,
     [close[1], ta.ema(close, emaFastL)[1], ta.ema(close, emaSlowL)[1]],
     lookahead = barmerge.lookahead_on)

bullRegime = htfClose > htfSlow and htfFast > htfSlow
bearRegime = htfClose < htfSlow and htfFast < htfSlow

// ---------------------------------------------------------- indicators ------
atr = ta.atr(atrLen)
[_, _, adx] = ta.dmi(adxLen, adxLen)

hiBrk = ta.highest(close, brkLen)[1]
loBrk = ta.lowest(close, brkLen)[1]

trailHiC = ta.highest(close, trailLen)
trailLoC = ta.lowest(close, trailLen)
trailHiH = ta.highest(high, trailLen)
trailLoL = ta.lowest(low, trailLen)

longSig  = allowLong  and bullRegime and close > hiBrk and (not useAdx or adx >= adxLong)
shortSig = allowShort and bearRegime and close < loBrk and (not useAdx or adx >= adxShort)

// ----------------------------------------------------------- state ----------
var float stopPx  = na
var float entryPx = na
var float riskPx  = na
var float tpPx    = na

// position size: equity × risk% ÷ stop distance, capped by max leverage
f_qty(float riskPct, float dist) =>
    float q    = dist > 0 ? strategy.equity * riskPct / 100 / dist : 0.0
    float qCap = strategy.equity * maxLev / close
    math.max(math.min(q, qCap), 0.0)

flat = strategy.position_size == 0

if flat and longSig and barstate.isconfirmed
    dist = stopMult * atr
    q = f_qty(riskLong, dist)
    if q > 0
        strategy.entry("Long", strategy.long, qty = q, comment = "L")
        entryPx := close
        riskPx  := dist
        stopPx  := close - dist
        tpPx    := close + tpR * dist

if flat and shortSig and barstate.isconfirmed
    dist = stopMult * atr
    q = f_qty(riskShort, dist)
    if q > 0
        strategy.entry("Short", strategy.short, qty = q, comment = "S")
        entryPx := close
        riskPx  := dist
        stopPx  := close + dist
        tpPx    := close - tpR * dist

// ------------------------------------------------------- trailing stop ------
float trailL = switch trailMode
    "Midpoint"   => (trailHiC + trailLoC) / 2
    "Chandelier" => trailHiH - chandMult * atr
    => trailLoL
float trailS = switch trailMode
    "Midpoint"   => (trailHiC + trailLoC) / 2
    "Chandelier" => trailLoL + chandMult * atr
    => trailHiH

// ratchet only in the trade's favour (only on bars after the entry bar)
if strategy.position_size > 0 and strategy.position_size[1] > 0
    stopPx := math.max(stopPx, trailL)
if strategy.position_size < 0 and strategy.position_size[1] < 0
    stopPx := math.min(stopPx, trailS)

// ---------------------------------------------------------------- exits -----
if usePartial
    strategy.exit("L-TP", from_entry = "Long",  qty_percent = 50, limit = tpPx, stop = stopPx, comment_profit = "TP", comment_loss = "SL")
    strategy.exit("S-TP", from_entry = "Short", qty_percent = 50, limit = tpPx, stop = stopPx, comment_profit = "TP", comment_loss = "SL")
strategy.exit("L-X", from_entry = "Long",  stop = stopPx, comment = "Exit L")
strategy.exit("S-X", from_entry = "Short", stop = stopPx, comment = "Exit S")

if flat and not (longSig or shortSig)
    stopPx := na
    tpPx   := na

// ------------------------------------------------------------- visuals ------
bgcolor(showRegBg ? (bullRegime ? color.new(color.teal, 92) : bearRegime ? color.new(color.red, 92) : na) : na, title = "Regime")
plot(showBands ? hiBrk : na, "Breakout high", color.new(color.teal, 40), 1, plot.style_stepline)
plot(showBands ? loBrk : na, "Breakout low",  color.new(color.red, 40),  1, plot.style_stepline)
plot(strategy.position_size != 0 ? stopPx : na, "Stop", color.orange, 2, plot.style_linebr)
plot(usePartial and strategy.position_size != 0 ? tpPx : na, "Target", color.new(color.lime, 30), 1, plot.style_linebr)
plotshape(flat and longSig,  "Long signal",  shape.triangleup,   location.belowbar, color.teal, size = size.small)
plotshape(flat and shortSig, "Short signal", shape.triangledown, location.abovebar, color.red,  size = size.small)

// ------------------------------------------------------------- alerts -------
if flat and longSig and barstate.isconfirmed
    alert("KyberSwing LONG " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " stop " + str.tostring(close - stopMult * atr, format.mintick), alert.freq_once_per_bar_close)
if flat and shortSig and barstate.isconfirmed
    alert("KyberSwing SHORT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " stop " + str.tostring(close + stopMult * atr, format.mintick), alert.freq_once_per_bar_close)

// ------------------------------------------------------ status table --------
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "KyberSwing", text_color = color.white)
    table.cell(tb, 1, 0, regTf + " regime", text_color = color.white)
    table.cell(tb, 0, 1, "Regime", text_color = color.silver)
    table.cell(tb, 1, 1, bullRegime ? "BULL (longs)" : bearRegime ? "BEAR (shorts)" : "NEUTRAL (flat)",
         text_color = bullRegime ? color.teal : bearRegime ? color.red : color.gray)
    table.cell(tb, 0, 2, "ADX", text_color = color.silver)
    table.cell(tb, 1, 2, str.tostring(adx, "#.0"), text_color = color.white)
    table.cell(tb, 0, 3, "ATR", text_color = color.silver)
    table.cell(tb, 1, 3, str.tostring(atr, format.mintick), text_color = color.white)
    table.cell(tb, 0, 4, "Position", text_color = color.silver)
    table.cell(tb, 1, 4, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color = color.white)

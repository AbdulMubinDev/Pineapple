// Probe 05: daily values on a 4h chart, non-repainting form and default-lookahead form.
//@version=6
strategy("Probe 05 MTF daily", overlay = true)

dPrevOn = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
dDefault = request.security(syminfo.tickerid, "D", close)

plot(dPrevOn, "prevOn")
plot(dDefault, "default")
